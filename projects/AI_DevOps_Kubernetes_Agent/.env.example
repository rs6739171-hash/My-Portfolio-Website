# Public demonstration requires no secret or cluster.
# For live mode, use a strong random token (at least 32 characters).
APP_AUTH_TOKEN=
KUBECONFIG_PATH=
KUBECTL_BIN=kubectl
KUBE_NAMESPACES=default
# Optional AI; choose a model available to your OpenRouter account.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Live logs must not leave your server unless explicitly enabled.
ALLOW_LIVE_LLM=false
# Use a persistent volume in a private deployment for durable live history.
HISTORY_DB=/tmp/kubescope-history.sqlite3
